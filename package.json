{
  "name": "netspeed",
  "version": "1.0.0",
  "description": "Cross-platform background tray app for real-time network speed monitoring",
  "main": "electron/main.js",
  "author": "NetSpeed",
  "license": "MIT",
  "scripts": {
    "dev:vite": "node init && vite --config vite.config.mjs",
    "dev:electron": "node init && electron .",
    "dev": "node init && concurrently -k \"npm run dev:vite\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "build:renderer": "node init && vite build --config vite.config.mjs",
    "build": "node init && npm run build:renderer",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "systeminformation": "^5.23.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.netspeed.app",
    "productName": "NetSpeed",
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "electron/**/*",
      "renderer/dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "LSUIElement": 1,
        "NSLocationWhenInUseUsageDescription": "NetSpeed accesses Wi-Fi SSID details to display your connected network name."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "runAfterFinish": true
    }
  }
}
